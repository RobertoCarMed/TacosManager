rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Ruta recomendada para tus productos
    match /taquerias/{taqueriaId}/products/{allPaths=**} {
      
      // ✅ Todos pueden leer imágenes
      allow read: if true;

      // 🔐 Solo usuarios autenticados pueden subir/modificar
      allow write: if request.auth != null;
    }

  }
}