rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function sameTaqueria(taqueriaId) {
      return hasUserDoc() && userData().taqueriaId == taqueriaId;
    }

    function hasRole(roles) {
      return hasUserDoc() && userData().role in roles;
    }

    function isCook() {
      return hasRole(['cook']);
    }

    function isWaiter() {
      return hasRole(['waiter']);
    }

    match /users/{userId} {
      allow create: if isOwnUser(userId);
      allow read: if isOwnUser(userId);
      allow update: if isOwnUser(userId);
      allow delete: if false;
    }

    match /taquerias/{taqueriaId} {
      // para validar existencia de taqueria durante registro
      allow read: if true;

      // crear taqueria al registrar cook/owner
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if sameTaqueria(taqueriaId) && hasRole(['cook']);
      allow delete: if false;

      match /orders/{orderId} {
        // Cook: puede leer todos los pedidos de su taqueria.
        // Waiter: solo puede leer pedidos creados por si mismo.
        allow get, list: if sameTaqueria(taqueriaId) && (
          isCook() ||
          (isWaiter() && resource.data.createdBy == request.auth.uid)
        );

        // Waiter/Cook pueden crear pedidos en su taqueria.
        // createdBy debe quedar fijo al uid autenticado.
        allow create: if sameTaqueria(taqueriaId)
          && hasRole(['waiter', 'cook'])
          && request.resource.data.createdBy == request.auth.uid;

        // Cook puede actualizar cualquier pedido de su taqueria.
        // Waiter solo puede actualizar sus pedidos y sin cambiar createdBy.
        allow update: if sameTaqueria(taqueriaId) && (
          (isCook() && request.resource.data.createdBy == resource.data.createdBy) ||
          (
            isWaiter()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
          )
        );

        allow delete: if false;
      }

      match /products/{productId} {
        // WaiterOrdersScreen también consulta products
        allow get, list: if sameTaqueria(taqueriaId) && hasRole(['waiter', 'cook']);
        allow create, update: if sameTaqueria(taqueriaId) && hasRole(['cook']);
        allow delete: if false;
      }
    }
  }
}
